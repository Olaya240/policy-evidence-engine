   "seed": 647852517,
   "version": 1,
   "versionNonce": 1690844388,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The attempt is spent and its quota is not refunded, so a failure cannot quietly become a loop; and the error\ncarries a code, so provider text and response headers never reach the caller. The mock adapter sits behind the\nsame boundary, so the demo exercises these refusals instead of bypassing them, and a real provider would\ninherit every check without a call site changing.",
   "originalText": "The attempt is spent and its quota is not refunded, so a failure cannot quietly become a loop; and the error\ncarries a code, so provider text and response headers never reach the caller. The mock adapter sits behind the\nsame boundary, so the demo exercises these refusals instead of bypassing them, and a real provider would\ninherit every check without a call site changing.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "autoResize": true,
   "containerId": null
  },
