  {
   "id": "text-c6a93913",
   "type": "text",
   "x": 126,
   "y": 1206.0,
   "width": 1059.9807999999998,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
