   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 5009222,
   "version": 1,
   "versionNonce": 1261344778,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "app/* serves :8081 while policy_* serves :8082 and :8083, so the two product paths share no runtime module.\npolicy_demo_graph.py is the only module that knows both layers: it projects the demo's pair and investigation\ninto typed nodes, while policy_dependency_graph imports nothing from the scenario layer. The challenge route\nre-projects and re-plans per request, so the graph is reached but never stored. Arrows are the imports that\ndefine a layer, not the full import graph.",
   "originalText": "app/* serves :8081 while policy_* serves :8082 and :8083, so the two product paths share no runtime module.\npolicy_demo_graph.py is the only module that knows both layers: it projects the demo's pair and investigation\ninto typed nodes, while policy_dependency_graph imports nothing from the scenario layer. The challenge route\nre-projects and re-plans per request, so the graph is reached but never stored. Arrows are the imports that\ndefine a layer, not the full import graph.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "autoResize": true,
   "containerId": null
  },
