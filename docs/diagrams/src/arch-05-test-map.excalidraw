  {
   "id": "text-4ca6b34e",
   "type": "text",
   "x": 126,
   "y": 1031.25,
   "width": 1040.6784,
   "height": 48.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1806933675,
   "version": 1,
   "versionNonce": 1424380604,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "62 tests assert nothing but raise, 15 of them in the contract module, and only 68 of 481 carry a docstring,\nso behaviour has to be read from the body. Two fail away from Windows: launcher identity is ntpath and\nPowerShell. And no test reaches the UI at all, which is why the hook-order crash survived until the review.",
   "originalText": "62 tests assert nothing but raise, 15 of them in the contract module, and only 68 of 481 carry a docstring,\nso behaviour has to be read from the body. Two fail away from Windows: launcher identity is ntpath and\nPowerShell. And no test reaches the UI at all, which is why the hook-order crash survived until the review.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "autoResize": true,
   "containerId": null
  },
  {
   "id": "text-873b5a6b",
   "type": "text",
   "x": 110,
   "y": 1131.0,
   "width": 759.3088,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#adb5bd",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 295160410,
   "version": 1,
   "versionNonce": 794033407,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Counts come from parsing backend/tests on 2026-10-30; they describe size, not defensibility.",
   "originalText": "Counts come from parsing backend/tests on 2026-10-30; they describe size, not defensibility.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "autoResize": true,
   "containerId": null
